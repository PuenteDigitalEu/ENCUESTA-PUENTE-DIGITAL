# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.
#
# Repo clonado del stack de otra app: estas variables son las que el código heredado usa.
# Los valores son de un proyecto Supabase / cuenta Resend NUEVOS para este repo, nunca los de
# la app de la que se clonó.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# URL y claves del proyecto nuevo (Supabase → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo en el servidor, nunca expuesta al cliente. No lleva prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── IA conversacional ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Aviso automático por email al completarse una encuesta ────────────────────
# Resend. Clave desde resend.com/api-keys.
RESEND_API_KEY=
# Email que recibe el aviso cuando alguien completa la encuesta.
ADVISOR_NOTIFICATION_EMAIL=

# ─── Límite de uso por IP (protección contra abuso) ────────────────────────────
# Secreto para hashear la IP (HMAC-SHA256). Cualquier cadena larga y aleatoria sirve —
# genera una con, p. ej., `openssl rand -hex 32`.
IP_HASH_PEPPER=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# Credenciales que consumen los servidores declarados en .mcp.json.
# De momento .mcp.json va sin servidores: se darán de alta cuando el stack esté decidido
# (ver "Protocolo de MCPs" en CLAUDE.md).
